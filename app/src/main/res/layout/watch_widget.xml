<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_background">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_name" android:textColor="#D7BC81" android:textSize="14sp" />
    <TextView android:id="@+id/widget_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="--:--" android:textColor="#F4F0E5" android:textSize="34sp" android:fontFamily="sans-serif-light" />
    <TextView android:id="@+id/widget_day" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/waiting" android:textColor="#B6C7BA" android:textSize="13sp" android:maxLines="2" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_stamp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#B6C7BA" android:textSize="11sp" android:maxLines="2" />
        <Button android:id="@+id/widget_refresh" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/refresh" android:textSize="11sp" android:textColor="#D7BC81" style="@android:style/Widget.Material.Button.Borderless" />
    </LinearLayout>
</LinearLayout>
